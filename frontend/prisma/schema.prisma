generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  avatarUrl String?  @map("avatar_url")
  jobTitle  String?  @map("job_title")
  phone     String?
  telegram  String?
  language  String   @default("en") // en, ru, uk
  role      String   @default("user") // user, admin, director
  settings  String?  @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teamMembers     TeamMember[]
  projectMembers  ProjectMember[]
  ownedTeams      Team[]          @relation("TeamOwner")
  assignedTasks   Task[]          @relation("TaskAssignee")
  createdTasks    Task[]          @relation("TaskCreator")
  watchedTasks    TaskWatcher[]
  comments        Comment[]
  activities      Activity[]
  checklistItems  ChecklistItem[] @relation("ChecklistAssignee")
  createdEvents   CalendarEvent[] @relation("CalendarEventCreator")
  eventAttendees  CalendarAttendee[]

  @@map("users")
}

model Team {
  id        String   @id @default(uuid())
  name      String
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner    User         @relation("TeamOwner", fields: [createdBy], references: [id], onDelete: Cascade)
  members  TeamMember[]
  projects Project[]
  calendarEvents CalendarEvent[]
  tags     Tag[]

  @@map("teams")
}

model TeamMember {
  id     String @id @default(uuid())
  teamId String @map("team_id")
  userId String @map("user_id")
  role   String @default("member") // owner, admin, member, viewer

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Project {
  id          String   @id @default(uuid())
  teamId      String   @map("team_id")
  name        String
  key         String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  team    Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members ProjectMember[]
  boards  Board[]
  epics   Epic[]
  sprints Sprint[]
  releases Release[]
  tasks   Task[]
  labels  Label[]
  calendarEvents CalendarEvent[]

  @@unique([teamId, key])
  @@map("projects")
}

model ProjectMember {
  id        String @id @default(uuid())
  projectId String @map("project_id")
  userId    String @map("user_id")
  role      String @default("member") // admin, member, viewer

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Board {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  title      String
  background String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns  Column[]
  tasks    Task[]
  releases ReleaseBoard[]

  @@map("boards")
}

model Column {
  id        String   @id @default(uuid())
  boardId   String   @map("board_id")
  title     String
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@map("columns")
}

model Epic {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  title       String
  color       String    @default("#15D8F5")
  startDate   DateTime? @map("start_date")
  dueDate     DateTime? @map("due_date")
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("epics")
}

model Sprint {
  id        String    @id @default(uuid())
  projectId String    @map("project_id")
  name      String
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  goal      String?
  status    String    @default("planned") // planned, active, closed
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("sprints")
}

model Release {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  name        String
  releaseDate DateTime? @map("release_date")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  status      String    @default("planned") // planned, on_track, delayed, released
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
  boards  ReleaseBoard[]

  @@map("releases")
}

model ReleaseBoard {
  id        String @id @default(uuid())
  releaseId String @map("release_id")
  boardId   String @map("board_id")

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  board   Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([releaseId, boardId])
  @@map("release_boards")
}

model Tag {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  name      String
  color     String
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("tags")
}

model Task {
  id           String    @id @default(uuid())
  projectId    String    @map("project_id")
  boardId      String?   @map("board_id")
  columnId     String?   @map("column_id")
  epicId       String?   @map("epic_id")
  parentId     String?   @map("parent_id")
  sprintId     String?   @map("sprint_id")
  releaseId    String?   @map("release_id")
  title        String
  description  String?
  assigneeId   String?   @map("assignee_id")
  creatorId    String    @map("creator_id")
  priority     String    @default("medium") // lowest, low, medium, high, critical
  status       String    @default("todo")
  startDate    DateTime? @map("start_date")
  dueDate      DateTime? @map("due_date")
  actualStart  DateTime? @map("actual_start")
  actualEnd    DateTime? @map("actual_end")
  estimate     Float?
  storyPoints  Int?      @map("story_points")
  position     Int       @default(0)
  progress     Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board        Board?          @relation(fields: [boardId], references: [id], onDelete: SetNull)
  column       Column?         @relation(fields: [columnId], references: [id], onDelete: SetNull)
  epic         Epic?           @relation(fields: [epicId], references: [id], onDelete: SetNull)
  parent       Task?           @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: SetNull)
  sprint       Sprint?         @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  release      Release?        @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  assignee     User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator      User            @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  subtasks     Task[]          @relation("TaskSubtasks")
  labels       TaskLabel[]
  watchers     TaskWatcher[]
  checklists   Checklist[]
  attachments  Attachment[]
  comments     Comment[]
  dependencies Dependency[]    @relation("TaskDependencies")
  dependents   Dependency[]    @relation("TaskDependents")

  @@map("tasks")
}

model Label {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  color     String
  createdAt DateTime @default(now()) @map("created_at")

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskLabel[]

  @@map("labels")
}

model TaskLabel {
  id      String @id @default(uuid())
  taskId  String @map("task_id")
  labelId String @map("label_id")

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([taskId, labelId])
  @@map("task_labels")
}

model TaskWatcher {
  id     String @id @default(uuid())
  taskId String @map("task_id")
  userId String @map("user_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_watchers")
}

model Checklist {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")

  task  Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items ChecklistItem[]

  @@map("checklists")
}

model ChecklistItem {
  id          String   @id @default(uuid())
  checklistId String   @map("checklist_id")
  text        String
  done        Boolean  @default(false)
  assigneeId  String?  @map("assignee_id")
  createdAt   DateTime @default(now()) @map("created_at")

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("ChecklistAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("checklist_items")
}

model Attachment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  name      String
  url       String
  size      Int
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  authorId  String   @map("author_id")
  body      String
  mentions  String?  @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Dependency {
  id              String   @id @default(uuid())
  predecessorId   String   @map("predecessor_id")
  successorId     String   @map("successor_id")
  type            String   @default("FS") // FS, SS, FF, SF
  lag             Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  predecessor Task @relation("TaskDependencies", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task @relation("TaskDependents", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@map("dependencies")
}

model Activity {
  id        String   @id @default(uuid())
  actorId   String   @map("actor_id")
  type      String
  payload   String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@map("activities")
}

model CalendarEvent {
  id          String    @id @default(uuid())
  projectId   String?   @map("project_id")
  teamId      String?   @map("team_id")
  title       String
  description String?
  location    String?
  startTime   DateTime  @map("start_time")
  endTime     DateTime  @map("end_time")
  allDay      Boolean   @default(false) @map("all_day")
  color       String    @default("#3B82F6")
  type        String    @default("meeting") // meeting, call, deadline, event, other
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project     Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team        Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator     User                @relation("CalendarEventCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  attendees   CalendarAttendee[]

  @@map("calendar_events")
}

model CalendarAttendee {
  id      String @id @default(uuid())
  eventId String @map("event_id")
  userId  String @map("user_id")
  status  String @default("pending") // pending, accepted, declined, tentative

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("calendar_attendees")
}
